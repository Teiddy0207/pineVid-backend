# Copy to .env and fill in the secrets:  cp .env.example .env
# This one file serves both `go run ./cmd/app` (loaded by godotenv) and
# `docker compose` (variable interpolation in docker-compose.yml).
# Generate secrets with:  openssl rand -hex 32

# App
APP_NAME=pipevid-backend
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Browser origins allowed by CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000
# Reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted; empty = no proxy
HTTP_TRUSTED_PROXIES=
# Logger
LOG_LEVEL=debug
# PG (host port 5435 is published by docker-compose.yml)
PG_POOL_MAX=2
PG_URL=postgres://user:CHANGE_ME@localhost:5435/db
# gRPC
GRPC_PORT=8081
# RMQ
RMQ_RPC_SERVER=rpc_server
RMQ_RPC_CLIENT=rpc_client
RMQ_URL=amqp://guest:guest@localhost:5672/
# NATS (host port 4223 is published by docker-compose.yml)
NATS_RPC_SERVER=rpc_server
NATS_URL=nats://guest:guest@localhost:4223/
# Redis (host port 6380) / SRS management API
REDIS_URL=localhost:6380
SRS_API_URL=http://localhost:1985
# Live ABR: backend uses master playlists only when LIVE_HLS_ENABLED=true.
SRS_HTTP_URL=http://localhost:8082
LIVE_HLS_PUBLIC_URL=http://localhost:8082
LIVE_HLS_ENABLED=false
# Compose renders these into SRS config; recreate SRS after changing them.
LIVE_TRANSCODE_ENABLED=off
LIVE_720_ENABLED=on
LIVE_480_ENABLED=on
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Tracing
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=0.1
# JWT: short-lived access token + rotating refresh token
JWT_SECRET=CHANGE_ME
JWT_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=168h
# Service-to-service webhook secret. Must be identical for the backend, the
# transcode worker (transcode/.env) and the SRS hooks (injected by compose).
# It is also the HMAC key of the signed transcode webhook.
INTERNAL_WEBHOOK_SECRET=CHANGE_ME
# Renditions requested in every transcode job (docs/message-contract.md §2.1)
TRANSCODE_RENDITIONS=720p,480p
# Set to false only for load tests with bot/
RATE_LIMIT_ENABLED=true
# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
DVR_LOCAL_DIR=./dvr-data

# Benchmark mode: lifts per-IP hourly view cap and 10s ticket wait.
# Set true only during load tests (k6/bench).
BENCHMARK_MODE=false
# Transcode mode: "async" = NATS queue (default); "sync" = inline FFmpeg
# (only for the comparison experiment, requires ffmpeg on PATH or FFMPEG_PATH).
TRANSCODE_MODE=async

# ---- docker-compose interpolation (see docker-compose.yml) ----
POSTGRES_PASSWORD=CHANGE_ME
NATS_USER=guest
NATS_PASSWORD=guest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
